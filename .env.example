# Copy this file to .env and replace the placeholders with real values.
# .env is gitignored; this example file is committed and must never hold real keys.

# Which provider to use: groq (development) or anthropic (official measurements)
PROVIDER=groq

# Groq (OpenAI-compatible API). Model must support tool use.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

