# Copy this file to .env and replace the placeholders with real values.
# .env is gitignored; this example file is committed and must never hold real keys.

# Which provider to use: groq (development) or anthropic (official measurements)
PROVIDER=groq

# Groq (OpenAI-compatible API). Model must support tool use.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Agent limits (optional; these are the defaults). Groq costs $0, so tokens are the
# real budget there.
# AGENT_MAX_STEPS=20
# AGENT_MAX_COST_USD=1.00
# AGENT_MAX_TOTAL_TOKENS=300000
# AGENT_REPEATED_FAILURE_LIMIT=3
